    create  table
      "carton_caps"."gold"."product_category_monthly__dbt_tmp"
  
    
    as (
      -- Category performance by month and user type, with share of spend and month-over-month growth.
with monthly as (
    select
        purchase_month          as month,
        category,
        user_type,
        count(*)                as purchases,
        sum(quantity)           as units,
        sum(price_paid)         as spend,
        count(distinct user_id) as buyers,
        sum(dollars_raised)     as dollars_raised
    from "carton_caps"."gold"."fct_purchases"
    group by all
)

select
    *,
    round(spend / sum(spend) over (partition by month, user_type), 4) as share_of_user_type_spend,
    round(spend / nullif(lag(spend) over (partition by category, user_type order by month), 0) - 1, 4)
                                                                     as spend_growth_vs_prior_month
from monthly
    );
    
  
[0m14:31:51.151739 [debug] [Thread-1 (]: Using duckdb connection "model.carton_caps.fct_referrals"
[0m14:31:51.153023 [debug] [Thread-1 (]: On model.carton_caps.fct_referrals: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "carton_caps", "target_name": "local", "node_id": "model.carton_caps.fct_referrals"} */

    

    create  table
      "carton_caps"."gold"."fct_referrals__dbt_tmp"
  
    
    as (
      -- One row per valid referral invite, with its funnel stage.
with referrals as (
    select * from "carton_caps"."silver"."int_referrals_checked" where dq_status = 'valid'
),

data_end as (
    select max(date_day) + interval 1 day as ends_at from "carton_caps"."gold"."dim_date"
),

first_purchases as (
    select user_id, min(purchased_at) as first_purchase_at
    from "carton_caps"."gold"."fct_purchases"
    group by user_id
),

invites_per_referrer as (
    select referrer_user_id, count(*) as invites
    from referrals
    group by referrer_user_id
),

-- People who joined through a referral, to mark earlier invites to them as assists.
referral_joiners as (
    select email_hash, joined_via_referral_id, signup_at
    from "carton_caps"."gold"."dim_users"
    where acquisition_channel = 'referral' and email_hash is not null
),

staged as (
    select
        r.referral_id,
        r.referrer_user_id,
        referrer.school_id                                        as referrer_school_id,
        referrer.user_type                                        as referrer_user_type,
        case when i.invites <= 2 then '1-2 invites'
             when i.invites <= 9 then '3-9 invites'
             else '10+ invites' end                               as referrer_segment,
        r.referred_user_id,
        referred.school_id                                        as referred_school_id,
        r.referred_email_hash,
        r.referral_code,
        r.sent_at,
        cast(date_trunc('month', r.sent_at) as date)              as sent_month,
        r.converted_at,
        r.status,
        r.status in ('clicked', 'converted')                      as is_clicked,
        r.status = 'converted'                                    as is_converted,
        r.status = 'converted'
            and fp.first_purchase_at <= r.converted_at + to_days(30)
                                                                  as is_qualified,
        -- Converted too recently to know yet whether they will qualify (right-censored).
        r.status = 'converted'
            and r.converted_at + to_days(30)
                <= (select ends_at from data_end)                 as is_qualification_window_complete,
        fp.first_purchase_at                                      as referred_first_purchase_at,
        round(date_diff('second', r.sent_at, r.converted_at) / 3600.0, 2) as hours_to_convert,
        referred.school_id = referrer.school_id                   as is_same_school,
        r.status <> 'converted' and exists (
            select 1 from referral_joiners as j
            where j.email_hash = r.referred_email_hash
              and j.joined_via_referral_id <> r.referral_id
              and r.sent_at < j.signup_at
        )                                                         as is_assist
    from referrals as r
    inner join "carton_caps"."gold"."dim_users" as referrer on referrer.user_id = r.referrer_user_id
    left join "carton_caps"."gold"."dim_users" as referred on referred.user_id = r.referred_user_id
    left join first_purchases as fp on fp.user_id = r.referred_user_id
    left join invites_per_referrer as i on i.referrer_user_id = r.referrer_user_id
)

select
    * exclude (referred_first_purchase_at),
    case when is_qualified then referred_first_purchase_at end      as qualified_at,
    case when is_qualified then 2 * 5 else 0 end as bonus_usd
from staged
    );
    
  
