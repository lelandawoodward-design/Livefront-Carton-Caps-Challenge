    create  table
      "carton_caps"."gold"."purchase_time_heatmap__dbt_tmp"
  
    
    as (
      -- Purchases by day of week and hour (all 168 cells, zero-filled).
with counts as (
    select day_of_week_number, hour_of_day, count(*) as purchases
    from "carton_caps"."gold"."fct_purchases"
    group by all
),

grid as (
    select d.day_of_week_number, h.hour_of_day
    from range(1, 8) as d(day_of_week_number)
    cross join range(0, 24) as h(hour_of_day)
)

select
    cast(g.day_of_week_number as integer)                 as day_of_week_number,
    ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][g.day_of_week_number]
                                                          as day_name,
    g.day_of_week_number in (6, 7)                        as is_weekend,
    cast(g.hour_of_day as integer)                        as hour_of_day,
    coalesce(c.purchases, 0)                              as purchases,
    round(coalesce(c.purchases, 0) / sum(coalesce(c.purchases, 0)) over (), 5) as share_of_purchases
from grid as g
left join counts as c
    on c.day_of_week_number = g.day_of_week_number and c.hour_of_day = g.hour_of_day
    );
    
  
[0m14:31:51.153730 [debug] [Thread-2 (]: On model.carton_caps.spending_by_segment: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "carton_caps", "target_name": "local", "node_id": "model.carton_caps.spending_by_segment"} */

    

    create  table
      "carton_caps"."gold"."spending_by_segment__dbt_tmp"
  
    
    as (
      -- Spending by school-district income level and user type: how much each group
-- buys, what it pays per purchase, how often it uses promotions, and what it raises.
with users as (
    select u.user_id, u.user_type, s.income_level
    from "carton_caps"."gold"."dim_users" as u
    inner join "carton_caps"."gold"."dim_schools" as s on s.school_id = u.school_id
),

per_user as (
    select
        user_id,
        count(*)                              as purchases,
        sum(quantity)                         as units,
        sum(list_amount)                      as list_amount,
        sum(price_paid)                       as spend,
        count(*) filter (where is_promo)      as promo_purchases,
        sum(dollars_raised)                   as dollars_raised
    from "carton_caps"."gold"."fct_purchases"
    group by all
)

select
    u.income_level,
    u.user_type,
    count(*)                                                          as users,
    count(p.user_id)                                                  as buying_users,
    coalesce(sum(p.purchases), 0)                                     as purchases,
    round(sum(p.purchases) / nullif(count(p.user_id), 0), 2)          as purchases_per_buyer,
    round(sum(p.units) / nullif(sum(p.purchases), 0), 2)              as units_per_purchase,
    round(sum(p.list_amount) / nullif(sum(p.units), 0), 2)            as avg_list_price_per_unit,
    round(sum(p.spend) / nullif(sum(p.purchases), 0), 2)              as spend_per_purchase,
    round(sum(p.spend) / nullif(count(p.user_id), 0), 2)              as spend_per_buyer,
    round(sum(p.promo_purchases) / nullif(sum(p.purchases), 0), 4)    as promo_share,
    coalesce(sum(p.spend), 0)                                         as spend,
    coalesce(sum(p.dollars_raised), 0)                                as dollars_raised,
    round(coalesce(sum(p.dollars_raised), 0) / count(*), 2)           as dollars_raised_per_user
from users as u
left join per_user as p on p.user_id = u.user_id
group by all
    );
    
  
