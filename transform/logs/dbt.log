[0m14:31:50.393727 [debug] [Thread-2 (]: On model.carton_caps.dim_date: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "carton_caps", "target_name": "local", "node_id": "model.carton_caps.dim_date"} */

    

    create  table
      "carton_caps"."gold"."dim_date__dbt_tmp"
  
    
    as (
      -- One row per day from the first signup to the last purchase or invite.
with bounds as (
    select
        cast(least(
            (select min(signup_at) from "carton_caps"."silver"."stg_users"),
            (select min(purchased_at) from "carton_caps"."silver"."int_purchases_checked" where dq_status = 'valid')
        ) as date) as first_day,
        cast(greatest(
            (select max(purchased_at) from "carton_caps"."silver"."int_purchases_checked" where dq_status = 'valid'),
            (select max(sent_at) from "carton_caps"."silver"."int_referrals_checked" where dq_status = 'valid'),
            (select max(signup_at) from "carton_caps"."silver"."stg_users")
        ) as date) as last_day
),

days as (
    select cast(d as date) as date_day
    from bounds, generate_series(bounds.first_day, bounds.last_day, interval 1 day) as t(d)
)

select
    date_day,
    cast(date_trunc('week', date_day) as date)  as week_start,
    cast(date_trunc('month', date_day) as date) as month_start,
    dayname(date_day)                           as day_name,
    isodow(date_day)                            as day_of_week_number,  -- 1 = Monday
    isodow(date_day) in (6, 7)                  as is_weekend,
    -- US school year runs August to July, e.g. 2023-24
    case when month(date_day) >= 8
         then cast(year(date_day) as varchar) || '-' || right(cast(year(date_day) + 1 as varchar), 2)
         else cast(year(date_day) - 1 as varchar) || '-' || right(cast(year(date_day) as varchar), 2)
    end                                         as school_year
from days
    );
    
  
