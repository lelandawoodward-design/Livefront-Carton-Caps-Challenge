            where entity = 'purchases' and action = 'quarantine'
        )) then 'quarantined'
        else 'valid'
    end as dq_status,
    (select max(batch_id) from "carton_caps"."meta"."ingested_files")                   as evaluated_batch_id  -- the run that last (re)checked this record
from checked
    );
    
  
  
